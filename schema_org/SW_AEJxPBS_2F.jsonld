  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "t_Peak",
      "description": "Time of WEJ and EEJ peaks in the order as they appear in the satellite flight direction, UTC<sup>4</sup>"
    },
    {
      "@type": "PropertyValue",
      "name": "Latitude_Peak",
      "unitText": "deg",
      "description": "Geocentric latitude in ITRF of WEJ and EEJ peaks in the order as they appear in the satellite flight direction"
    },
    {
      "@type": "PropertyValue",
      "name": "Longitude_Peak",
      "unitText": "deg",
      "description": "Geocentric longitude in ITRF of WEJ and EEJ peaks in the order as they appear in the satellite flight direction"
    },
