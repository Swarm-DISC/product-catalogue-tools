  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "Timestamp",
      "description": "Time of satellite crossing of the magnetic equator, UTC"
    },
    {
      "@type": "PropertyValue",
      "name": "Longitude",
      "unitText": "degrees",
      "description": "Geographic longitude of satellite crossing of the magnetic equator"
    },
    {
      "@type": "PropertyValue",
      "name": "Latitude",
      "unitText": "degrees",
      "description": "Geographic latitude of satellite crossing of the magnetic equator"
    },
    {
      "@type": "PropertyValue",
      "name": "EEF",
      "unitText": "mV/m",
      "description": "Estimate of the equatorial electric field"
    },
    {
      "@type": "PropertyValue",
      "name": "EEJ_meast",
      "unitText": "A/km",
      "description": "Height-integrated magnetic eastward current profile, spanning [-20:0.5:20] degrees QD latitude"
    },
    {
      "@type": "PropertyValue",
      "name": "EEJ_mnorth",
      "unitText": "A/km",
      "description": "Height-integrated magnetic northward current profile, spanning [-20:0.5:20] degrees QD latitude"
    },
    {
      "@type": "PropertyValue",
      "name": "RelErr",
      "description": "Quality indicator of EEF estimate; relative error between modeled and observed current profile"
    },
    {
      "@type": "PropertyValue",
      "name": "Flags",
      "description": "Flags describing data gaps and satellite identification"
    },
    {
      "@type": "PropertyValue",
      "name": "Timestamp_Track",
      "description": "Timestamps along track, length provided in Length_Track"
    },
    {
      "@type": "PropertyValue",
      "name": "Latitude_Track",
      "unitText": "degrees",
      "description": "Latitudes along track, length provided in Length_Track"
    },
    {
      "@type": "PropertyValue",
      "name": "Longitude_Track",
      "unitText": "degress",
      "description": "Longitudes along track, length provided in Length_Track"
    },
    {
      "@type": "PropertyValue",
      "name": "Radius_Track",
      "unitText": "km",
      "description": "Geocentric radii along track, length provided in Length_Track"
    },
    {
      "@type": "PropertyValue",
      "name": "Ksq_Track",
      "unitText": "A/km",
      "description": "Surface current of estimated Sq signal, packed in geocentric north,east components,, length 2*Length_Track"
    },
    {
      "@type": "PropertyValue",
      "name": "Keej_Track",
      "unitText": "A/km",
      "description": "Surface current of estimated EEJ signal, packed in geocentric north,east components,, length 2*Length_Track"
    },
    {
      "@type": "PropertyValue",
      "name": "Length_Track",
      "description": "Array of track lengths"
    }
  ]
}