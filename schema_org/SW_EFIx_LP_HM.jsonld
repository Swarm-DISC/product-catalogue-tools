    },
    {
      "@type": "PropertyValue",
      "name": "Height",
      "unitText": "km",
      "description": "Height above reference ellipsoid, WGS84"
    },
    {
      "@type": "PropertyValue",
      "name": "Radius",
      "unitText": "km",
      "description": "Distance from the Earth's centre"
    },
    {
      "@type": "PropertyValue",
      "name": "SZA",
      "unitText": "deg",
      "description": "Solar Zenith Angle"
    },
    {
      "@type": "PropertyValue",
      "name": "SAz",
      "unitText": "deg",
      "description": "Solar Azimuth in Earth frame, north is 0 deg"
    },
    {
      "@type": "PropertyValue",
      "name": "ST",
      "unitText": "hours",
      "description": "Apparent Solar Time"
    },
    {
      "@type": "PropertyValue",
      "name": "Diplat",
      "unitText": "deg",
      "description": "Quasi-dipole latitude"
    },
    {
      "@type": "PropertyValue",
      "name": "Diplon",
      "unitText": "deg",
      "description": "Quasi-dipole longitude"
    },
    {
      "@type": "PropertyValue",
      "name": "MLat",
      "unitText": "deg",
      "description": "Magnetic latitude"
    },
    {
      "@type": "PropertyValue",
      "name": "MLT",
      "unitText": "hours",
      "description": "Magnetic local time based on quasi-dipole"
    },
    {
      "@type": "PropertyValue",
      "name": "AACGMLat",
      "unitText": "deg",
      "description": "Altitude-adjusted corrected geomagnetic latitude"
    },
    {
      "@type": "PropertyValue",
      "name": "AACGMLon",
      "unitText": "deg",
      "description": "Altitude-adjusted corrected geomagnetic longitude"
    },
    {
