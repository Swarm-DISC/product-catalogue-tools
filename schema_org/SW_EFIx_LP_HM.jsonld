      "name": "T_elec",
      "unitText": "K",
      "description": "Electron temperature, blended value"
    },
    {
      "@type": "PropertyValue",
      "name": "Vs_hgn",
      "unitText": "V",
      "description": "Spacecraft potential, estimated by the high gain probe"
    },
    {
      "@type": "PropertyValue",
      "name": "Vs_lgn",
      "unitText": "V",
      "description": "Spacecraft potential, estimated by the low gain probe"
    },
    {
      "@type": "PropertyValue",
