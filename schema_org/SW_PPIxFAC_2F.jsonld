  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "Timestamp",
      "unitText": "ms",
      "description": "Time of observation, UTC"
    },
    {
      "@type": "PropertyValue",
      "name": "Counter",
      "description": "Swarm orbit counter and quarter orbit (four per Swarm orbit) counter that are based on magnetic coordinates as defined in <a href=\"https://earth.esa.int/eogateway/documents/20142/37627/Swarm-PRISM-Description-of-the-algorithm.pdf\">Swarm PRISM processing algorithm description</a> (Sect. 4.1.2.2)"
    },
    {
      "@type": "PropertyValue",
      "name": "Latitude",
      "unitText": "deg",
      "description": "Position of the SSFAC boundary in ITRF - Geocentric latitude"
    },
    {
      "@type": "PropertyValue",
      "name": "Longitude",
      "unitText": "deg",
      "description": "Position of the SSFAC boundary in ITRF - Geocentric longitude"
    },
    {
      "@type": "PropertyValue",
      "name": "Radius",
      "unitText": "m",
      "description": "Position of the SSFAC boundary in ITRF - Geocentric radius (from the Earth center)"
    },
    {
      "@type": "PropertyValue",
      "name": "Latitude_QD",
      "unitText": "deg",
      "description": "QD latitude of the SSFAC boundary"
    },
    {
      "@type": "PropertyValue",
      "name": "Longitude_QD",
      "unitText": "deg",
      "description": "QD longitude of the SSFAC boundary"
    },
    {
      "@type": "PropertyValue",
      "name": "MLT",
      "unitText": "h",
      "description": "Magnetic Local Time of SSFAC boundary"
    },
    {
      "@type": "PropertyValue",
      "name": "L_value",
      "unitText": "R_E",
      "description": "L-value of the SSFAC boundary"
    },
    {
      "@type": "PropertyValue",
      "name": "SZA",
      "unitText": "deg",
      "description": "Solar zenith angle of the SSFAC boundary"
    },
    {
      "@type": "PropertyValue",
      "name": "dL",
      "description": "Boundary width in Earth radii"
    },
    {
      "@type": "PropertyValue",
      "name": "Sigma",
      "description": "Standard deviation of the linear fit of S at the boundary (Heilig, B. and Lühr, H., doi: 10.5194/angeo-31-529-2013)"
    },
    {
      "@type": "PropertyValue",
      "name": "PPI",
      "unitText": "R_E",
      "description": "Midnight Plasmapause index"
    },
    {
      "@type": "PropertyValue",
      "name": "Quality",
      "description": "Quality indicators of SSFAC boundary detection"
    },
    {
      "@type": "PropertyValue",
      "name": "Timestamp_ID",
      "description": "Time vector of observations"
    },
    {
      "@type": "PropertyValue",
      "name": "Latitude_ID",
      "unitText": "deg",
      "description": "Position in ITRF - Geocentric latitude"
    },
    {
      "@type": "PropertyValue",
      "name": "Longitude_ID",
      "unitText": "deg",
      "description": "Position in ITRF - Geocentric longitude"
    },
    {
      "@type": "PropertyValue",
      "name": "Radius_ID",
      "unitText": "m",
      "description": "Position in ITRF - Geocentric radius (from the Earth centre)"
    },
    {
      "@type": "PropertyValue",
      "name": "Latitude_QD_ID",
      "unitText": "deg",
      "description": "QD latitude"
    },
    {
      "@type": "PropertyValue",
      "name": "Longitude_QD_ID",
      "unitText": "deg",
      "description": "QD longitude"
    },
    {
      "@type": "PropertyValue",
      "name": "MLT_ID",
      "unitText": "h",
      "description": "Magnetic Local Time"
    },
    {
      "@type": "PropertyValue",
