      "description": "L-value in Earth radii"
    },
    {
      "@type": "PropertyValue",
      "name": "SZA_ID",
      "unitText": "deg",
      "description": "L-value in Earth radii"
    },
    {
      "@type": "PropertyValue",
      "name": "Position_Quality_ID",
      "description": "Vector of quality indicators characterising the detection quality of each single positions"
    }
