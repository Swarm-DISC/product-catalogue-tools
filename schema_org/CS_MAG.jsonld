  "includedInDataCatalog": {
    "@type": "DataCatalog",
    "name": "Swarm Product Data Handbook",
    "url": "https://swarmhandbook.earth.esa.int/catalogue"
  },
  "distribution": [
    {
      "@type": "DataDownload",
      "contentUrl": "https://swarm-diss.eo.esa.int/#swarm/Multimission/CryoSat-2",
      "encodingFormat": "application/x-cdf"
    },
    {
      "@type": "DataDownload",
      "contentUrl": "ftp://swarm-diss.eo.esa.int/Multimission/CryoSat-2",
      "encodingFormat": "application/x-cdf"
    },
    {
      "@type": "DataDownload",
      "contentUrl": "http://hapi-server.org/servers/#server=VirES-for-Swarm&dataset=CS_OPER_MAG",
      "encodingFormat": "application/json"
    }
  ],
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "name": "Timestamp",
      "description": "Time stamp"
    },
    {
      "@type": "PropertyValue",
      "name": "Latitude",
      "unitText": "deg",
      "description": "Position in ITRF: Geocentric latitude"
    },
    {
      "@type": "PropertyValue",
      "name": "Longitude",
      "unitText": "deg",
      "description": "Position in ITRF: Geocentric longitude"
    },
    {
      "@type": "PropertyValue",
      "name": "Radius",
      "unitText": "m",
      "description": "Position in ITRF: Geocentric Radius"
    },
    {
      "@type": "PropertyValue",
      "name": "B_FGM1",
      "unitText": "nT",
      "description": "calibrated magnetic vector from FGM1, in instrument frame"
    },
    {
      "@type": "PropertyValue",
      "name": "B_FGM2",
      "unitText": "nT",
      "description": "calibrated magnetic vector from FGM2, in instrument frame"
    },
    {
      "@type": "PropertyValue",
      "name": "B_FGM3",
      "unitText": "nT",
      "description": "calibrated magnetic vector from FGM3, in instrument frame"
    },
    {
      "@type": "PropertyValue",
      "name": "B_NEC1",
      "unitText": "nT",
      "description": "calibrated and aligned magnetic vector from FGM1, in NEC (North, East, Center) frame"
    },
    {
      "@type": "PropertyValue",
      "name": "B_NEC2",
      "unitText": "nT",
      "description": "calibrated and aligned magnetic vector from FGM2, in NEC (North, East, Center) frame"
    },
    {
      "@type": "PropertyValue",
      "name": "B_NEC3",
      "unitText": "nT",
      "description": "calibrated and aligned magnetic vector from FGM3, in NEC (North, East, Center) frame"
    },
    {
      "@type": "PropertyValue",
      "name": "B_NEC",
      "unitText": "nT",
      "description": "calibrated and aligned magnetic vector in NEC (North, East, Center) frame, 5 sample (i.e. 20 second) robust average of all 3 FGM,"
    },
    {
      "@type": "PropertyValue",
      "name": "F",
      "unitText": "nT",
      "description": "magnetic field intensity determined from B_NEC,"
    },
    {
      "@type": "PropertyValue",
      "name": "B_mod_NEC",
      "unitText": "nT",
      "description": "CHAOS-6 model field (core, crust + magnetosphere), in NEC (North, East, Center) frame"
    },
    {
      "@type": "PropertyValue",
      "name": "q_NEC_CRF",
      "description": "Quaternion, transformation: NEC <- CRF"
    },
    {
      "@type": "PropertyValue",
      "name": "q_error",
      "description": "experimental error indicator of attitude given in Quaternion q_NEC_CRF. Bad attitude if > approx 40"
    }
  ]
}